#!/bin/bash -e

# Ensure shared volume directories exist and are writable
mkdir -p /etc/letsencrypt/live /etc/letsencrypt/selfsigned /etc/nginx/conf.d

# Prepare the database (creates it if new, runs pending migrations if existing)
if [[ "$*" == *"rails server"* ]]; then
  ./bin/rails db:prepare
fi

exec "$@"
